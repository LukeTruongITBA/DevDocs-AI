{
  "info": {
    "name": "DevDocs AI - Story 3 Task 1 - Safe metadata filtering",
    "description": "URL metadata filters on POST /api/query/retrieve (pre-retrieval-service).\n\nSyntax: repeated `filter=<field>:<operator>:<value>`, `filterMode=AND|OR` (default AND).\nFields: source_type, document_id, version_id, version, is_current, source, page, fetch_date.\nDefault IDs match the 2026-11-27 database (Story 1 and Story 2 ingestion); change the collection variables for another database.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8084"
    },
    {
      "key": "aclDocId",
      "value": "10"
    },
    {
      "key": "oracleDocId",
      "value": "12"
    },
    {
      "key": "oracleVersionId",
      "value": "11"
    },
    {
      "key": "mkdocsDocId",
      "value": "13"
    },
    {
      "key": "mkdocsVersionId",
      "value": "12"
    }
  ],
  "item": [
    {
      "name": "01 Null filter → standard version-scoped flow",
      "request": {
        "description": "No filter parameters: unchanged behaviour, versionId required, appliedFilter is null.",
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"query\": \"How do I configure the theme?\",\n  \"topK\": 5,\n  \"versionId\": \"{{mkdocsVersionId}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/query/retrieve",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "query",
            "retrieve"
          ],
          "query": []
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "",
              "const fail = (m) => { throw new Error(m); };",
              "const json = () => pm.response.json();",
              "const status = (code) => pm.test('HTTP ' + code, () => { if (pm.response.code !== code) fail('got ' + pm.response.code); });",
              "const all = (label, pred) => pm.test(label, () => {",
              "  const r = json().results; if (!Array.isArray(r) || r.length === 0) fail('expected at least one result');",
              "  r.forEach((x, i) => { if (!pred(x)) fail('result #' + i + ' (chunk ' + x.id + ') violates filter'); });",
              "});",
              "const pageOf = (x) => x.pageNumber ?? (x.metadata && x.metadata.page && x.metadata.page.pdf_page_number);",
              "",
              "status(200);",
              "pm.test('appliedFilter is null', () => { if (json().appliedFilter !== null) fail(JSON.stringify(json().appliedFilter)); });",
              "all('all results in versionId', (x) => String(x.versionId) === pm.variables.get('mkdocsVersionId'));"
            ]
          }
        }
      ]
    },
    {
      "name": "02 AND: source_type=WEB AND document_id in (Oracle PDF, MkDocs)",
      "request": {
        "description": "Two conditions joined by AND (default filterMode).",
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"query\": \"How do I configure the theme?\",\n  \"topK\": 5\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/query/retrieve?filter=source_type:eq:WEB&filter=document_id:in:{{oracleDocId}},{{mkdocsDocId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "query",
            "retrieve"
          ],
          "query": [
            {
              "key": "filter",
              "value": "source_type:eq:WEB"
            },
            {
              "key": "filter",
              "value": "document_id:in:{{oracleDocId}},{{mkdocsDocId}}"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "",
              "const fail = (m) => { throw new Error(m); };",
              "const json = () => pm.response.json();",
              "const status = (code) => pm.test('HTTP ' + code, () => { if (pm.response.code !== code) fail('got ' + pm.response.code); });",
              "const all = (label, pred) => pm.test(label, () => {",
              "  const r = json().results; if (!Array.isArray(r) || r.length === 0) fail('expected at least one result');",
              "  r.forEach((x, i) => { if (!pred(x)) fail('result #' + i + ' (chunk ' + x.id + ') violates filter'); });",
              "});",
              "const pageOf = (x) => x.pageNumber ?? (x.metadata && x.metadata.page && x.metadata.page.pdf_page_number);",
              "",
              "status(200);",
              "pm.test('mode AND with 2 conditions', () => { const f = json().appliedFilter; if (f.mode !== 'AND' || f.conditions.length !== 2) fail(JSON.stringify(f)); });",
              "const ids = [pm.variables.get('oracleDocId'), pm.variables.get('mkdocsDocId')];",
              "all('every result is WEB and in the document list', (x) => x.metadata.source_type === 'WEB' && ids.includes(String(x.documentId)));"
            ]
          }
        }
      ]
    },
