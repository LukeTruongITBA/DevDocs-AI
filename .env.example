# PostgreSQL
POSTGRES_DB=devdocs
POSTGRES_USER=devdocs
POSTGRES_PASSWORD=change-me

# Shared ingestion configuration
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
INGESTION_MAX_PAGES=100
INGESTION_REQUEST_TIMEOUT_SECONDS=20
INGESTION_MAX_BATCH_SOURCES=4
INGESTION_MAX_EXTRACTED_CHARACTERS=100000
INGESTION_MAX_CHUNKS_PER_SOURCE=200

# Embeddings (compose.yaml): local Ollama nomic-embed-text, 768 dimensions,
# stored in chunks.embedding_ollama VECTOR(768) (migration V4). Containers
# reach the host's Ollama through host.docker.internal.
OLLAMA_EMBEDDING_URL=http://host.docker.internal:11434/api/embed
OLLAMA_EMBEDDING_MODEL=nomic-embed-text:137m-v1.5-fp16
OLLAMA_EMBEDDING_BATCH_SIZE=16

# Legacy Gemini embedding path (chunks.embedding VECTOR(1536)). Only used when
# a service runs outside compose with EMBEDDING_PROVIDER=gemini,
# EMBEDDING_API_URL=<Gemini batchEmbedContents URL>, EMBEDDING_MODEL=models/gemini-embedding-001
# and EMBEDDING_DIMENSIONS=1536.
GEMINI_API_KEY=
# Gemini retry is disabled by default until provider quota is verified.
EMBEDDING_MAX_ATTEMPTS=1
EMBEDDING_INITIAL_BACKOFF_MILLIS=250
EMBEDDING_MAX_BACKOFF_MILLIS=2000
EMBEDDING_JITTER_RATIO=0.2
