# PostgreSQL
POSTGRES_DB=devdocs
POSTGRES_USER=devdocs
POSTGRES_PASSWORD=change-me

# Shared ingestion configuration
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
INGESTION_MAX_PAGES=100
INGESTION_REQUEST_TIMEOUT_SECONDS=20
INGESTION_MAX_BATCH_SOURCES=4
INGESTION_MAX_EXTRACTED_CHARACTERS=100000
INGESTION_MAX_CHUNKS_PER_SOURCE=200
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta/models/gemini-embedding-001:batchEmbedContents
GEMINI_API_KEY=
EMBEDDING_MODEL=models/gemini-embedding-001
EMBEDDING_DIMENSIONS=1536
EMBEDDING_BATCH_SIZE=64
# Retry is disabled by default until provider quota is verified.
EMBEDDING_MAX_ATTEMPTS=1
EMBEDDING_INITIAL_BACKOFF_MILLIS=250
EMBEDDING_MAX_BACKOFF_MILLIS=2000
EMBEDDING_JITTER_RATIO=0.2
